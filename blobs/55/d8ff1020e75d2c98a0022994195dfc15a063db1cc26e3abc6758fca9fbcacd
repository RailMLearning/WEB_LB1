, "index": 0, "bbox": [0.02, 0.004, 0.996, 0.994], "content": "const goods = ['Хлеб', 'Молоко'];\nconsole.log(todos[0]); // 'Хлеб'\nconst filteredGoods = goods.filter(good => good == \"Хлеб\")\n// ['Хлеб']\nconst mappedGoods = goods.map(good => good[0])\n// ['X', 'M']\nconst mappedGoods = goods.find(good => good == \"Хлеб\")\n// Хлеб\ngoods.forEach(good => console.log)\n// Хлеб\n// Молоко\nМассив – упорядоченный список чего угодно.\nЭлементы получаем по индексу, начиная с 0\nМетоды\n• map – преобразует каждый элемент,\nсоздавая новый массив\n• filter – оставляет только те элементы, что проходят проверку\n• find – находит первый подходящий элемент\n• forEach – просто выполняет действие для каждого элемента"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 39, "blocks": [{"type": "image", "index": 0, "bbox": [0.074, 0.006, 0.997, 1.0], "content": [{"type": "image_body", "index": 0, "bbox": [0.074, 0.006, 0.997, 1.0], "content": ""}]}]}], "is_full_document": false, "schema": "docvortex.middle", "schema_version": "2.0"}