, 0.718], "content": [{"type": "text", "content": "∙ @PathVariable — часть пути, @RequestBody — тело запроса"}]}, {"type": "text", "index": 8, "bbox": [0.637, 0.731, 0.932, 0.815], "content": [{"type": "text", "content": "∙ @Valid — проверка тела, при ошибке 400"}]}, {"type": "text", "index": 9, "bbox": [0.637, 0.831, 0.889, 0.92], "content": [{"type": "text", "content": "∙ Возвращаемый объект превращается в JSON сам"}]}]}, {"page_idx": 3, "blocks": [{"type": "header", "index": 0, "bbox": [0.862, 0.018, 0.979, 0.054], "content": [{"type": "text", "content": "страница 4/55"}]}, {"type": "header", "index": 1, "bbox": [0.031, 0.078, 0.446, 0.145], "content": [{"type": "text", "content": "Эндпоинт в Jakarta REST"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.975, 0.147], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "code", "index": 3, "bbox": [0.068, 0.337, 0.527, 0.994], "content": [{"type": "code_body", "index": 3, "bbox": [0.068, 0.337, 0.527, 0.994], "content": "@ApplicationPath(\"/api\")\npublic class App extends Application {}\n\n@Path(\"/students\")\n@RequestMappingd\npublic class StudentResource {\n    @Inject StudentService service;\n\n    @GET @Path)/{id}\")\n    @Produces(MediaType.APPLICATION_JSON)\n    public StudentDto get(@PathParam(\"id\") long id) {\n        return service.find(id);\n    }\n\n    @POST\n    @Consumes(MediaType.APPLICATION_JSON)\n    public Response create(\n        @Valid CreateStudentRequest request) {\n        StudentDto created = service.create(request);\n        return Response.status(201).entity(created).build();\n    }\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "text", "index": 4, "bbox": [0.637, 0.281, 0.93, 0.412], "content": [{"type": "text", "content": "∙ Application + @ApplicationPath — точка входа и префикс всего API"}], "continues_prev": true}, {"type": "text", "index": 5, "bbox": [0.637, 0.423, 0.935, 0.512], "content": [{"type": "text", "content": "∙ @Path — путь, @GET, @POST 