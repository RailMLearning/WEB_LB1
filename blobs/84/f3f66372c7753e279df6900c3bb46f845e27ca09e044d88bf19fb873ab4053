rface RandomInt {\n    @Nonbinding int min() default 0;\n    @Nonbinding int max() default 10;\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "code", "index": 4, "bbox": [0.072, 0.601, 0.502, 0.979], "content": [{"type": "code_body", "index": 4, "bbox": [0.072, 0.601, 0.502, 0.979], "content": "@ApplicationScoped\npublic class RandomProducer {\n    @Produces @RandomInt\n    int random(InjectionPoint ip) {\n        RandomInt a = ip.getAnnotated()\n            .getAnnotation(RandomInt.class);\n        return ThreadLocalRandom.current()\n            .nextInt(a.min(), a.max() + 1);\n    }\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "text", "index": 5, "bbox": [0.591, 0.265, 0.979, 0.354], "content": [{"type": "text", "content": "Использование: @Inject @RandomInt(min = 2, max = 7) int repeat;"}]}, {"type": "text", "index": 6, "bbox": [0.619, 0.409, 0.915, 0.54], "content": [{"type": "text", "content": "∙ @Produces — метод, который производит значение для внедрения"}]}, {"type": "text", "index": 7, "bbox": [0.619, 0.554, 0.894, 0.684], "content": [{"type": "text", "content": "∙ InjectionPoint — куда внедряем: можно прочитать аннотацию поля"}]}, {"type": "text", "index": 8, "bbox": [0.619, 0.698, 0.927, 0.787], "content": [{"type": "text", "content": "∙ @Nonbinding — параметры не влияют на выбор producer’а"}]}, {"type": "text", "index": 9, "bbox": [0.591, 0.822, 0.914, 0.956], "content": [{"type": "text", "content": "Spring даёт залезть в любой объект. CDI даёт типобезопасную точку расширения.", "styles": ["bold"]}]}]}, {"page_idx": 21, "blocks": [{"type": "code", "index": 0, "bbox": [0.663, 0.279, 0.933, 0.37], "content": [{"type": "code_body", "index": 0, "bbox": [0.663, 0.279, 0.933, 0.37], "content": "- JVM на лету создаёт класс, который реализует Quoter"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "header", "index": 1, "bbox": [0.03, 0.079, 0.41, 0.151], "content": [{"type": "text", "content": "Динамический прокси"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.017, 0.979, 0.147], "content": [{"type": "text", "content": "страница 22/55 viTMO"}]}, {"type": "code", "index": 3, "bbox": [0.071, 0.372, 0.581, 0.8], "content": [{"type": "code_body", "index": 3, "bbox": [0.071, 0.372, 0.581, 0.8], "content": "Quoter real = new TerminatorQuoter();\n\nQuoter proxy = (Quoter) Proxy.newProxyInstance(\n    Quoter.class.getClassLoader(),\n    new Class<?>[]{ Quoter.class },\n    (p, method, args) -> {\n        System.out.println(\"before\");\n        return method.invoke(real, args);\n    });\n\nproxy.sayQuote();"}], "sub_type": "code", "guess_lang": "java"}, {"type": "code", "index": 4, "bbox": [0.663, 0.382, 0.92, 0.512], "content": [{"type": "code_body", "index": 4, "bbox": [0.663, 0.382, 0.92, 0.512], "content": "- Каждый вызов попадает в лямбду — можно сделать что-то до и после"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "text", "index": 5, "bbox": [0.663, 0.526, 0.887, 0.615], "content": [{"type": "text", "content": "∙ Работает "}, {"type": "text", "content": "только через интерфейс", "styles": ["bold"]}]}, {"type": "text", "index": 6, "bbox": [0.663, 0.626, 0.944, 0.803], "content": [{"type": "text", "content": "∙ Нет интерфейса — CGLIB или ByteBuddy генерируют "}, {"type": "text", "content": "подкласс", "styles": ["bold"]}, {"type": "text", "content": ", поэтому final обернуть нельзя"}]}, {"type": "code", "index": 7, "bbox": [0.079, 0.907, 0.811, 0.961], "content": [{"type": "code_body", "index": 7, "bbox": [0.079, 0.907, 0.811, 0.961], "content": "Так BeanPostProcessor может подменить бин обёрткой — следующий слайд"}], "sub_type": "code", "guess_lang": "txt"}]}, {"page_idx": 22, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.031, 0.076, 0.487, 0.154], "content": [{"type": "text", "content": "@Profiling: свой прокси"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.979, 0.148], "content": [{"type": "text", "content": "страница 23/55 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.044, 0.446, 0.437, 0.849], "content": [{"type": "code_body", "index": 2, "bbox": [0.044, 0.446, 0.437, 0.849], "content": "// before: remember the original class\npublic Object postProcessBeforeInitialization(\n    Object bean, String name) {\n    Class<?> c = bean.getClass();\n    if (c.isAnnotationPresent(Profiling.class))\n        map.put(name, c);\n    return bean;\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "code", "index": 3, "bbox": [0.513, 0.447, 0.923, 0.859], "content": [{"type": "code_body", "index": 3, "bbox": [0.513, 0.447, 0.923, 0.859], "content": "// after: return a proxy\npublic Object postProcessAfterInitialization(\n    Object bean, String name) {\n    Class<?> c = map.get(name);\n    if (c == null) return bean;\n    return Proxy.newProxyInstance(\n        c.getClassLoader(), c.getInterfaces(),\n        (proxy, m, args) -> {\n            long t = System.nanoTime();\n            try { return m.invoke(bean, args); }\n            finally { log(m, System.nanoTime() - t); }\n        });\n}"}], "sub_type": "code", "guess_lang": "java"}]}, {"page_idx": 23, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.031, 0.082, 0.364, 0.15], "content": [{"type": "text", "content": "Почему именно так"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.979, 0.147], "content": [{"type": "text", "content": "страница 24/55 viTMO"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.075, 0.355, 0.209, 0.409], "content": [{"type": "text", "content": "Зачем map"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.072, 0.419, 0.445, 0.656], "content": [{"type": "text", "content": "К фазе after бин может быть уже обёрнут "}, {"type": "text", "content": "другим", "styles": ["bold"]}, {"type": "text", "content": " BPP, и аннотацию на прокси не найти. Поэтому класс запоминается в before, пока объект ещё настоящий."}]}, {"type": "image", "index": 4, "bbox": [0.399, 0.351, 0.452, 0.399], "content": [{"type": "image_body", "index": 4, "bbox": [0.399, 0.351, 0.452, 0.399], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.545, 0.351, 0.927, 0.609], "content": [{"type": "text", "content": "Почему прокси в after 0 8 Если вернуть прокси в before, следующие BPP и @PostConstruct получат прокси вместо настоящего объекта и не найдут его поля."}]}, {"type": "image", "index": 6, "bbox": [0.873, 0.351, 0.925, 0.399], "content": [{"type": "image_body", "index": 6, "bbox": [0.873, 0.351, 0.925, 0.399], "content": ""}]}, {"type": "text", "index": 7, "bbox": [0.081, 0.738, 0.941, 0.788], "content": [{"type": "text", "content": "∙ JDK Proxy требует интерфейс, иначе — CGLIB-подкласс (по умолчанию в Spring Boot)"}]}, {"type": "text", "index": 8, "bbox": [0.082, 0.807, 0.863, 0.855], "content": [{"type": "text", "content": "∙ Профилирование можно включать и выключать на лету, например через JMX"}]}, {"type": "text", "index": 9, "bbox": [0.082, 0.873, 0.929, 0.97], "content": [{"type": "text", "content": "∙ "}, {"type": "text", "content": "Ответ на вопрос из начала:", "styles": ["bold"]}, {"type": "text", "content": " @Transactional обрабатывает такой же BPP (AnnotationAwareAspectJAutoProxyCreator). Отсюда $$SpringCGLIB$$0"}]}]}, {"page_idx": 24, "blocks": [{"type": "header", "index": 0, "bbox": [0.029, 0.078, 0.434, 0.15], "content": [{"type": "text", "content": "Jakarta EE: перехватчик"}]}, {"type": "header", "index": 1, "bbox": [0.796, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 25/55 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.069, 0.33, 0.528, 0.994], "content": [{"type": "code_body", "index": 2, "bbox": [0.069, 0.33, 0.528, 0.994], "content": "@InterceptorBinding\n@Retention(RUNTIME) @Target({TYPE, METHOD})\npublic @interface Profiling {}\n\n@Profiling @Interceptor\n@Priority(Interceptor.Priority.APPLICATION)\npublic class ProfilingInterceptor {\n\n    @AroundInvoke\n    Object time(InvocationContext ctx) throws Exception {\n        long t = System.nanoTime();\n        try {\n            return ctx.proceed();   // the real method\n        } finally {\n            log(ctx.getMethod(), System.nanoTime() - t);\n        }\n    }\n}\n\n@Profiling\n@ApplicationScoped\npublic class TerminatorQuoter implements Quoter { ... }"}], "sub_type": "code", "guess_lang": "java"}, {"type": "text", "index": 3, "bbox": [0.637, 0.281, 0.91, 0.453], "content": [{"type": "text", "content": "@InterceptorBinding — аннотация-связка: где стоит @Profiling, там работает перехватчик"}]}, {"type": "text", "index": 4, "bbox": [0.637, 0.47, 0.939, 0.598], "content": [{"type": "text", "content": "∙ @AroundInvoke — код вокруг вызова, ctx.proceed() вызывает настоящий метод"}]}, {"type": "text", "index": 5, "bbox": [0.637, 0.612, 0.921, 0.743], "content": [{"type": "text", "content": "∙ Обёртку-подкласс контейнер создаёт сам — свой BPP и Proxy не нужны"}]}, {"type": "text", "index": 6, "bbox": [0.637, 0.759, 0.942, 0.886], "content": [{"type": "text", "content": "∙ @Priority включает перехватчик; без него он молча выключен"}]}]}, {"page_idx": 25, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.979, 0.054], "content": [{"type": "text", "content": "страница 26/55"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.031, 0.078, 0.456, 0.152], "content": [{"type": "text", "content": "Трёхфазный конструктор"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "text", "index": 3, "bbox": [0.24, 0.272, 0.759, 0.323], "content": [{"type": "text", "content": "Вопрос залу: почему в конструкторе repeat == 0?"}]}, {"type": "table", "index": 4, "bbox": [0.079, 0.353, 0.921, 0.76], "content": [{"type": "table_body", "index": 4, "bbox": [0.079, 0.353, 0.921, 0.76], "content": "<table><tbody><tr><td>Фаза</td><td>Что уже есть</td><td>Чего ещё нет</td></tr><tr><td>1. Конструктор</td><td>только сам объект</td><td>зависимостей и полей от BPP</td></tr><tr><td>2. @PostConstruct</td><td>зависимости, поля от BPP</td><td>прокси: @Transactional ипрофилирование здесь неработают</td></tr><tr><td>3. После старта</td><td>всё, включая прокси</td><td>-</td></tr><tr><td>контекста</td><td></td><td></td></tr></tbody></table>"}]}, {"type": "text", "index": 5, "bbox": [0.088, 0.862, 0.91, 0.914], "content": [{"type": "text", "content": "@PostConstruct вызывает BPP в before, а прокси появляется позже — в after"}]}]}, {"page_idx": 26, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.03, 0.079, 0.455, 0.151], "content": [{"type": "text", "content": "Фаза 3: зачем она нужна"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.979, 0.148], "content": [{"type": "text", "content": "страница 27/55 viTMO"}]}, {"type": "text", "index": 2, "bbox": [0.196, 0.296, 0.796, 0.402], "content": [{"type": "text", "content": "К третьей фазе "}, {"type": "text", "content": "все BPP уже отработали", "styles": ["bold"]}, {"type": "text", "content": ": бин обёрнут прокси, @Transactional, @Async, профилирование работают"}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.229, 0.436, 0.298, 0.491], "content": [{"type": "text", "content": "Spring"}], "level": 2}, {"type": "code", "index": 4, "bbox": [0.069, 0.559, 0.436, 0.849], "content": [{"type": "code_body", "index": 4, "bbox": [0.069, 0.559, 0.436, 0.849], "content": "@Component\npublic class Warmup {\n    @Autowired StudentService service; // proxy\n\n    @EventListener(ContextRefreshedEvent.class)\n    public void warmUp() {\n        service.loadDictionaries();   // tx works\n    }\n}"}], "sub_type": "code", "guess_lang": "groovy"}, {"type": "paragraph_title", "index": 5, "bbox": [0.684, 0.436, 0.788, 0.488], "content": [{"type": "text", "content": "Jakarta EE"}], "level": 2}, {"type": "code", "index": 6, "bbox": [0.542, 0.557, 0.91, 0.855], "content": [{"type": "code_body", "index": 6, "bbox": [0.542, 0.557, 0.91, 0.855], "content":