curity\npublic class SecurityConfig {\n    @Bean\n    SecurityFilterChain chain(HttpSecurity http)\n        throws Exception {\n        return http\n            .authorizeHttpRequests(a -> a\n                .requestMatchers(\"/public/**\").permitAll()\n                .requestMatchers(HttpMethod.GET, \"/students/**\")\n                .authenticated()\n                .anyRequest().hasRole(\"ADMIN\"))\n            .httpBasic(Customizer.withDefaults())\n            .build();\n    }\n    @Bean PasswordEncoder encoder() {\n        return new BCryptPasswordEncoder();\n    }\n}\n@Service public class StudentService {\n    @PreAuthorize(\"hasRole('ADMIN')\" )  // proxy\n    public void delete(long id) { ... }\n}"}], "sub_type": "code", "guess_lang": "groovy"}, {"type": "text", "index": 3, "bbox": [0.637, 0.281, 0.899, 0.368], "content": [{"type": "text", "content": "∙ Правила для URL — в бине SecurityFilterChain"}]}, {"type": "text", "index": 4, "bbox": [0.637, 0.382, 0.909, 0.557], "content": [{"type": "text", "content": "∙ @PreAuthorize — защита метода через "}, {"type": "text", "content": "прокси", "styles": ["bold"]}, {"type": "text", "content": ": те же ловушки, что у @Transactional"}]}, {"type": "text", "index": 5, "bbox": [0.637, 0.573, 0.95, 0.7], "content": [{"type": "text", "content": "∙ Пароли хранятся только как хеш: BCryptPasswordEncoder сам добавляет соль"}]}, {"type": "text", "index": 6, "bbox": [0.637, 0.715, 0.949, 0.846], "content": [{"type": "text", "content": "∙ Старый базовый класс-адаптер из примеров в интернете удалён в Spring Security 6"}]}]}, {"page_idx": 49, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.018, 0.979, 0.054], "content": [{"type": "text", "content": "страница 50/55"}]}, {"type": "header", "index": 1, "bbox": [0.03, 0.078, 0.293, 0.151], "content": [{"type": "text", "content": "Jakarta Security"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.147], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "code", "index": 3, "bbox": [0.063, 0.394, 0.54, 0.911], "content": [{"type": "code_body", "index": 3, "bbox": [0.063, 0.394, 0.54, 0.911], "content": "@BasicAuthenticationMechanismDefinition(\n    realName = \"students\")\n@DatabaseIdentityStoreDefinition(\n    dataSourceLookup = \"java:app/jdbc/StudentsDS\",\n    callerQuery = \"select hash from users where name =?\",\n    groupsQuery = \"select role from roles where name = ?\")\n@ApplicationScoped\npublic class SecurityConfig {}\n\n@Path(\"/students\") @RequestScoped\npublic class StudentResource {\n    @Inject SecurityContext security;\n\n    @DELETE @Path(\"/{id}\") @RolesAllowed(\"ADMIN\")\n    public void delete(@PathParam(\"id\") long id) { ... }\n}"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "text", "index": 4, "bbox": [0.621, 0.309, 0.904, 0.388], "content": [{"type": "text", "content": "Стандарт с Java EE 8, поверх Jakarta Authentication."}]}, {"type": "text", "index": 5, "bbox": [0.648, 0.398, 0.978, 0.512], "content": [{"type": "text", "content": "∙ "}, {"type": "text", "content": "Как", "styles": ["bold"]}, {"type": "text", "content": " получить учётные данные: HttpAuthenticationMechanism — Basic, Form, OpenID Connect, свой"}]}, {"type": "text", "index": 6, "bbox": [0.648, 0.52, 0.951, 0.597], "content": [{"type": "text", "content": "∙ "}, {"type": "text", "content": "Где", "styles": ["bold"]}, {"type": "text", "content": " проверить: IdentityStore — БД, LDAP, свой"}]}, {"type": "text", "index": 7, "bbox": [0.648, 0.605, 0.932, 0.683], "content": [{"type": "text", "content": "∙ Текущий пользователь: @Inject SecurityContext"}]}, {"type": "text", "index": 8, "bbox": [0.649, 0.691, 0.9, 0.769], "content": [{"type": "text", "content": "∙ @RolesAllowed проверяет контейнер"}]}, {"type": "text", "index": 9, "bbox": [0.648, 0.777, 0.908, 0.855], "content": [{"type": "text", "content": "∙ Пароли в БД по умолчанию — Pbkdf2PasswordHash"}]}]}], "is_full_document": false, "schema": "docvortex.mid