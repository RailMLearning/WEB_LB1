\n});"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 13, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.056, 0.075, 0.39, 0.155], "content": [{"type": "text", "content": "Методы Promise"}], "level": 2}, {"type": "code", "index": 1, "bbox": [0.053, 0.242, 0.324, 0.628], "content": [{"type": "code_body", "index": 1, "bbox": [0.053, 0.242, 0.324, 0.628], "content": "Promise.all - метод,\nвозвращающий промис,\nисполняющийся по\nисполнению всех или\nотклонению одного из\nпереданных ему\nпромисов."}], "sub_type": "code", "guess_lang": "txt"}, {"type": "paragraph_title", "index": 2, "bbox": [0.055, 0.679, 0.191, 0.729], "content": [{"type": "text", "content": "Есть также:"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.065, 0.734, 0.254, 0.782], "content": [{"type": "text", "content": "- Promise.race"}]}, {"type": "text", "index": 4, "bbox": [0.066, 0.789, 0.284, 0.837], "content": [{"type": "text", "content": "- Promise.resolve"}]}, {"type": "text", "index": 5, "bbox": [0.066, 0.844, 0.269, 0.895], "content": [{"type": "text", "content": "- Promise.reject"}]}, {"type": "code", "index": 6, "bbox": [0.371, 0.002, 0.972, 0.747], "content": [{"type": "code_body", "index": 6, "bbox": [0.371, 0.002, 0.972, 0.747], "content": "const p1 = Promise.resolve(0);\nconst p2 = 1337;\nconst p3 = new Promise((resolve, reject) => {\n    setTimeout(resolve, 100, \"foo\");\n});\n\nPromise.all([p1, p2, p3]).then((values) => {\n    console.log(values);\n});"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 14, "blocks": [{"type": "code", "index": 0, "bbox": [0.039, 0.004, 0.995, 0.937], "content": [{"type": "code_body", "index": 0, "bbox": [0.039, 0.004, 0.995, 0.937], "content": "async/await - ключевые слова, упрощающие работу с промисами\n    async - указывает, что функция всегда возвращает промис\n    await - указывает, что интерпретатор ждет окончания выполнения промиса\n        async function f() {\n            let promise = new Promise((resolve, reject) => {\n                setTimeout(() => resolve(\"готово!\", 1000)\n            });\n            let result = await promise;\n            console.log(result); // \"готово!\"\n        }\n        f();"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 15, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.055, 0.077, 0.309, 0.156], "content": [{"type": "text", "content": "Async/await"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.8, 0.053, 0.972, 0.148], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "code", "index": 2, "bbox": [0.025, 0.298, 0.989, 0.86], "content": [{"type": "code_body", "index": 2, "bbox": [0.025, 0.298, 0.989, 0.86], "content": "async function f() {\n    async function getNumberAsync() {\n        return 42;\n    }\n    let result = await getNumberAsync();\n    console.log(result); // \"42\"\n}\nf();"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 16, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.057, 0.078, 0.444, 0.152], "content": [{"type": "text", "content": "Обработка ошибок"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.801, 0.052, 0.971, 0.146], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "code", "index": 2, "bbox": [0.247, 0.176, 0.803, 0.964], "content": [{"type": "code_body", "index": 2, "bbox": [0.247, 0.176, 0.803, 0.964], "content": "async function loadUser() {\n    try {\n        const response = await fetch(\"/api/users/1\");\n\n        if (!response.ok) {\n            throw new Error(\"Не удалось загрузить пользователя\");\n        }\n\n        const user = await response.json();\n        console.log(\"User:\", user);\n    } catch (error) {\n        console.error(\"Error:\", error.message);\n    } finally {\n        console.log(\"Request completed\");\n    }\n}\n\nloadUser();"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 17, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.055, 0.08, 0.349, 0.147], "content": [{"type": "text", "content": "AJAX, Fetch API"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.798, 0.054, 0.971, 0.153], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "paragraph_title", "index": 2, "bbox": [0.06, 0.238, 0.128, 0.286], "content": [{"type": "text", "content": "AJAX"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.059, 0.352, 0.411, 0.523], "content": [{"type": "text", "content": "AJAX (Asynchronous JavaScript and XML) - подход, при котором JavaScript обменивается данными с сервером и обновляет часть интерфейса без полной перезагрузки."}]}, {"type": "text", "index": 4, "bbox": [0.059, 0.556, 0.386, 0.631], "content": [{"type": "text", "content": "Примеры: поиск, фильтры, пагинация, формы, уведомления."}]}, {"type": "paragraph_title", "index": 5, "bbox": [0.551, 0.475, 0.712, 0.526], "content": [{"type": "text", "content": "Инструменты"}], "level": 2}, {"type": "text", "index": 6, "bbox": [0.55, 0.591, 0.825, 0.636], "content": [{"type": "text", "content": "Исторически - XMLHttpRequest."}]}, {"type": "text", "index": 7, "bbox": [0.55, 0.674, 0.891, 0.754], "content": [{"type": "text", "content": "Сегодня для новых приложений обычно используют Fetch API."}]}, {"type": "text", "index": 8, "bbox": [0.55, 0.794, 0.899, 0.872], "content": [{"type": "text", "content": "XML в названии не означает, что данные обязаны быть XML: чаще приходит JSON."}]}]}, {"page_idx": 18, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.056, 0.079, 0.397, 0.153], "content": [{"type": "text", "content": "XMLHttpRequest"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.801, 0.053, 0.971, 0.146], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "image", "index": 2, "bbox": [0.06, 0.46, 0.177, 0.641], "content": [{"type": "image_body", "index": 2, "bbox": [0.06, 0.46, 0.177, 0.641], "content": ""}]}, {"type": "code", "index": 3, "bbox": [0.263, 0.164, 0.735, 0.941], "content": [{"type": "code_body", "index": 3, "bbox": [0.263, 0.164, 0.735, 0.941], "content": "const request = new XMLHttpRequest(); //создание объекта\n\nrequest.open(\"GET\", \"/api/users/1\"); //конфигурация запроса\nrequest.responseType = \"json\";\n\n//слушатель на получение ответа\nrequest.addEventListener(\"load\", () => {\n    //обработка ответа\n    if (request.status >= 200 && request.status < 300) {\n        console.log(\"User:\", request.response);\n    } else {\n        console.error(\"HTTP error:\", request.status);\n    }\n});\n\n//слушатель на ошибку\nrequest.addEventListener(\"error\", () => {\n    console.error(\"Network error\");\n});\n\n//отправка запроса\nrequest.send();"}], "sub_type": "code", "guess_lang": "javascript"}]}, {"page_idx": 19, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.055, 0.076, 0.249, 0.148], "content": [{"type": "text", "content": "Fetch API"}], "level": 2}, {"type": "paragraph_title", "index": 1, "bbox": [0.8, 0.052, 0.972, 0.147], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "image", "index": 2, "bbox": [0.0, 0.393, 0.184, 0.603], "content": [{"type": "image_body", "index": 2, "bbox": [0.0, 0.393, 0.184, 0.603], "content": ""}]}, {"type": "code", "index": 3, "bbox": [0.211, 0.174, 0.788, 0.961], "content": [{"type": "code_body", "index": 3, "bbox": [0.211, 0.174, 0.788, 0.961], "content": "async function loadUser() {\n    try {\n        const response = await fetch(\"/api/users/1\");\n\n        if (!response.ok) {\n            throw new Error(`HTTP error: \\${response.status}`);\n        }\n\n        const user = await response.json();\n\n        console.log(\"User:\", user);\n    } catch (error) {\n        console.error(\"Request error:\", error.message);\n    }\n}\n\nloadUser();"}], "sub_type": "code", "guess_lang": "javascript"}]}], "is_full_document": false, "schema": "docvortex.middle", "schema_version": "2.0"}