x": 4, "bbox": [0.399, 0.406, 0.452, 0.456], "content": [{"type": "image_body", "index": 4, "bbox": [0.399, 0.406, 0.452, 0.456], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.074, 0.471, 0.42, 0.564], "content": [{"type": "text", "content": "ОС", "styles": ["bold"]}, {"type": "text", "content": " прерывает задачу в любой момент. Где: процессы и потоки."}]}, {"type": "text", "index": 6, "bbox": [0.072, 0.585, 0.452, 0.715], "content": [{"type": "text", "content": "+ зависшая задача не вешает остальные − прервать могут посреди «прочитать — изменить — записать»: гонки, нужен Lock"}]}, {"type": "paragraph_title", "index": 7, "bbox": [0.548, 0.41, 0.733, 0.465], "content": [{"type": "text", "content": "Кооперативная"}], "level": 2}, {"type": "image", "index": 8, "bbox": [0.872, 0.406, 0.926, 0.456], "content": [{"type": "image_body", "index": 8, "bbox": [0.872, 0.406, 0.926, 0.456], "content": ""}]}, {"type": "text", "index": 9, "bbox": [0.547, 0.471, 0.86, 0.566], "content": [{"type": "text", "content": "Задача "}, {"type": "text", "content": "сама", "styles": ["bold"]}, {"type": "text", "content": " отдаёт управление на await. Где: asyncio, JavaScript."}]}, {"type": "text", "index": 10, "bbox": [0.547, 0.583, 0.905, 0.715], "content": [{"type": "text", "content": "+ между await никто не вмешается − не отдала управление (time.sleep, долгий расчёт) — стоят все"}]}, {"type": "text", "index": 11, "bbox": [0.185, 0.815, 0.813, 0.869], "content": [{"type": "text", "content": "Минус вытесняющей — часть 4, минус кооперативной — часть 5"}]}]}, {"page_idx": 21, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.054], "content": [{"type": "text", "content": "страница 22/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.079, 0.702, 0.152], "content": [{"type": "text", "content": "Воркеры: несколько копий приложения"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.147], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "image", "index": 3, "bbox": [0.083, 0.306, 0.914, 0.743], "content": [{"type": "image_body", "index": 3, "bbox": [0.083, 0.306, 0.914, 0.743], "content": ""}, {"type": "image_caption", "index": 4, "bbox": [0.074, 0.797, 0.925, 0.889], "content": [{"type": "text", "content": "Каждый воркер — отдельный процесс со своей памятью. Словарь students у каждого свой."}]}]}]}, {"page_idx": 22, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.031, 0.078, 0.367, 0.151], "content": [{"type": "text", "content": "Память и 4 воркера"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.98, 0.148], "content": [{"type": "text", "content": "страница 23/50 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.053, 0.413, 0.431, 0.904], "content": [{"type": "code_body", "index": 2, "bbox": [0.053, 0.413, 0.431, 0.904], "content": "students = {}  # per process\n\n    @app.post(\"/students/{isu}\")\n    def create(isu: int):\n        students[isu] = {\"isu\": isu}\n\n    @app.get(\"/students/{isu}\")\n    def get(isu: int):\n        return students[isu]\n\nuvicorn app:app --workers 4"}], "sub_type": "code", "guess_lang": "python"}, {"type": "code", "index": 3, "bbox": [0.512, 0.433, 0.869, 0.518], "content": [{"type": "code_body", "index": 3, "bbox": [0.512, 0.433, 0.869, 0.518], "content": "POST /students/1 -> worker 2: 201\nGET /students/1 -> worker 3: 404"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "text", "index": 4, "bbox": [0.571, 0.639, 0.866, 0.736], "content": [{"type": "text", "content": "студент сохранён, но в памяти другого процесса"}]}]}, {"page_idx": 23, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.029, 0.079, 0.501, 0.152], "content": [{"type": "text", "content": "Пул соединений × воркеры"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.795, 0.017, 0.98, 0.148], "content": [{"type": "text", "content": "страница 24/50 viTMO"}]}, {"type": "text", "index": 2, "bbox": [0.236, 0.268, 0.414, 0.323], "content": [{"type": "text", "content": "Воркер 1 пул до 15"}]}, {"type": "text", "index": 3, "bbox": [0.236, 0.368, 0.414, 0.423], "content": [{"type": "text", "content": "Воркер 2 пул до 15"}]}, {"type": "image", "index": 4, "bbox": [0.213, 0.244, 0.783, 0.639], "content": [{"type": "image_body", "index": 4, "bbox": [0.213, 0.244, 0.783, 0.639], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.235, 0.465, 0.415, 0.523], "content": [{"type": "text", "content": "Воркер 3 пул до 15"}]}, {"type": "text", "index": 6, "bbox": [0.235, 0.566, 0.414, 0.623], "content": [{"type": "text", "content": "Воркер 4 пул до 15"}]}, {"type": "text", "index": 7, "bbox": [0.603, 0.354, 0.768, 0.505], "content": [{"type": "text", "content": "PostgreSQL по умолчанию до 100 соединений"}]}, {"type": "text", "index": 8, "bbox": [0.229, 0.659, 0.419, 0.708], "content": [{"type": "text", "content": ". . . и ещё 4 воркера"}]}, {"type": "text", "index": 9, "bbox": [0.046, 0.784, 0.472, 0.977], "content": [{"type": "text", "content": "Пул живёт "}, {"type": "text", "content": "в каждом процессе", "styles": ["bold"]}, {"type": "text", "content": " свой: соединение нельзя передать другому процессу. SQLAlchemy по умолчанию держит до 5 + 10 = 15 соединений на пул."}]}, {"type": "text", "index": 10, "bbox": [0.519, 0.784, 0.94, 0.979], "content": [{"type": "text", "content": "8 воркеров × 15 = "}, {"type": "text", "content": "120", "styles": ["bold"]}, {"type": "text", "content": " > 100. Новые соединения база отклонит: too many clients already. Считайте: воркеры × размер пула ≤ лимит БД."}]}]}, {"page_idx": 24, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.054], "content": [{"type": "text", "content": "страница 25/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.031, 0.08, 0.381, 0.151], "content": [{"type": "text", "content": "Что из этого следует"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.074, 0.405, 0.306, 0.463], "content": [{"type": "text", "content": "Хранение в памяти"}], "level": 2}, {"type": "image", "index": 4, "bbox": [0.399, 0.403, 0.452, 0.453], "content": [{"type": "image_body", "index": 4, "bbox": [0.399, 0.403, 0.452, 0.453], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.099, 0.494, 0.371, 0.591], "content": [{"type": "text", "content": "∙ Работает только с "}, {"type": "text", "content": "одним", "styles": ["bold"]}, {"type": "text", "content": " воркером"}]}, {"type": "text", "index": 6, "bbox": [0.099, 0.611, 0.43, 0.708], "content": [{"type": "text", "content": "∙ Перезапуск сервера — данные пропали"}]}, {"type": "text", "index": 7, "bbox": [0.099, 0.729, 0.44, 0.825], "content": [{"type": "text", "content": "∙ В реальных системах состояние выносят в БД или Redis"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.548, 0.405, 0.66, 0.463], "content": [{"type": "text", "content": "Stateless"}], "level": 2}, {"type": "image", "index": 9, "bbox": [0.872, 0.402, 0.926, 0.453], "content": [{"type": "image_body", "index": 9, "bbox": [0.872, 0.402, 0.926, 0.453], "content": ""}]}, {"type": "text", "index": 10, "bbox": [0.572, 0.495, 0.883, 0.594], "content": [{"type": "text", "content": "∙ Любой воркер должен уметь обработать любой запрос"}]}, {"type": "text", "index": 11, "bbox": [0.573, 0.611, 0.872, 0.757], "content": [{"type": "text", "content": "∙ Значит, между запросами в воркере ничего важного не храним"}]}, {"type": "text", "index": 12, "bbox": [0.572, 0.776, 0.918, 0.873], "content": [{"type": "text", "content": "∙ Тогда воркеры можно добавлять без изменений кода"}]}]}, {"page_idx": 25, "blocks": [{"type": "image", "index": 0, "bbox": [0.513, 0.472, 0.567, 0.523], "content": [{"type": "image_body", "index": 0, "bbox": [0.513, 0.472, 0.567, 0.523], "content": ""}]}, {"type": "header", "index": 1, "bbox": [0.852, 0.017, 0.98, 0.056], "content": [{"type": "text", "content": "страница 26/50"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.03, 0.079, 0.556, 0.151], "content": [{"type": "text", "content": "Часть 3. Блокирующие вызовы"}], "level": 2}, {"type": "paragraph_title", "index": 3, "bbox": [0.083, 0.475, 0.31, 0.532], "content": [{"type": "text", "content": "Чем занят бэкенд?"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.083, 0.546, 0.553, 0.707], "content": [{"type": "text", "content": "Большую часть времени — "}, {"type": "text", "content": "ничем", "styles": ["bold"]}, {"type": "text", "content": ". Он ждёт: ответа базы данных, чтения файла, другого сервиса."}]}, {"type": "text", "index": 5, "bbox": [0.083, 0.728, 0.561, 0.784], "content": [{"type": "text", "content": "Вопрос в том, что делает сервер, пока ждёт."}]}]}, {"page_idx": 26, "blocks": [{"type": "header", "index": 0, "bbox": [0.03, 0.076, 0.429, 0.147], "content": [{"type": "text", "content": "I/O-bound и CPU-bound"}]}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.979, 0.148], "content": [{"type": "text", "content": "страница 27/50 viTMO"}]}, {"type": "chart", "index": 2, "bbox": [0.159, 0.197, 0.849, 0.636], "content": [{"type": "chart_body", "index": 2, "bbox": [0.159, 0.197, 0.849, 0.636], "content": ""}, {"type": "chart_footnote", "index": 3, "bbox": [0.063, 0.717, 0.441, 0.859], "content": [{"type": "text", "content": "I/O-bound — типичный веб. Ускоряем, делая что-то полезное во время ожидания."}]}, {"type": "chart_footnote", "index": 4, "bbox": [0.529, 0.717, 0.928, 0.814], "content": [{"type": "text", "content": "CPU-bound — редкость в вебе. Ускоряем только дополнительными ядрами."}]}]}]}, {"page_idx": 27, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.054], "content": [{"type": "text", "content": "страница 28/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.079, 0.387, 0.151], "content": [{"type": "text", "content": "Блокирующий вызов"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "chart", "index": 3, "bbox": [0.102, 0.326, 0.901, 0.628], "content": [{"type": "chart_body", "index": 3, "bbox": [0.102, 0.326, 0.901, 0.628], "content": ""}, {"type": "chart_footnote", "index": 4, "bbox": [0.085, 0.688, 0.913, 0.784], "content": [{"type": "text", "content": "Блокирующий вызов — поток останавливается и ничего не делает, пока не придёт результат: time.sleep(), requests.get(), обычный драйвер БД, чтение файла."}]}, {"type": "chart_footnote", "index": 5, "bbox": [0.112, 0.804, 0.884, 0.853], "content": [{"type": "text", "content": "Два способа не простаивать: больше потоков (часть 4) или event loop (часть 5)."}]}]}]}, {"page_idx": 28, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.016, 0.98, 0.056], "content": [{"type": "text", "content": "страница 29/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.078, 0.395, 0.147], "content": [{"type": "text", "content": "Часть 4. Потоки и GIL"}], "level": 2}, {"type": "paragraph_title", "index": 2, "bbox": [0.795, 0.069, 0.975, 0.152], "content": [{"type": "text", "content": "VITMO"}], "level": 2}, {"type": "paragraph_title", "index": 3, "bbox": [0.083, 0.475, 0.154, 0.535], "content": [{"type": "text", "content": "Идея"}], "level": 2}, {"type": "text", "index": 4, "bbox": [0.082, 0.543, 0.518, 0.656], "content": [{"type": "text", "content": "Если один поток ждёт, пусть в это время работает другой."}]}, {"type": "text", "index": 5, "bbox": [0.082, 0.67, 0.498, 0.784], "content": [{"type": "text", "content": "Так устроены Flask, Django и обычные def-обработчики FastAPI."}]}]}, {"page_idx": 29, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.03, 0.078, 0.31, 0.152], "content": [{"type": "text", "content": "Потоки в Python"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.795, 0.017, 0.98, 0.148], "content": [{"type": "text", "content": "страница 30/50 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.071, 0.454, 0.502, 0.85], "content": [{"type": "code_body", "index": 2, "bbox": [0.071, 0.454, 0.502, 0.85], "content": "from concurrent.futures import (\n    ThreadPoolExecutor)\n\ndef fetch(url):\n    r = requests.get(url)\n    return r.status_code\n\nwith ThreadPoolExecutor(10) as pool:\n    codes = list(pool.map(fetch, urls))"}], "sub_type": "code", "guess_lang": "python"}, {"type": "paragraph_title", "index": 3, "bbox": [0.583, 0.434, 0.629, 0.489], "content": [{"type": "text", "content": "GIL"}], "level": 2}, {"type": "image", "index": 4, "bbox": [0.872, 0.432, 0.926, 0.482], "content": [{"type": "image_body", "index": 4, "bbox": [0.872, 0.432, 0.926, 0.482], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.582, 0.498, 0.913, 0.647], "content": [{"type": "text", "content": "Global Interpreter Lock", "styles": ["bold"]}, {"type": "text", "content": ": в каждый момент Python-код выполняет только "}, {"type": "text", "content": "один", "styles": ["bold"]}, {"type": "text", "content": " поток процесса."}]}, {"type": "text", "index": 6, "bbox": [0.582, 0.661, 0.916, 0.764], "content": [{"type": "text", "content": "Пока поток ждёт I/O, GIL отпущен и работают другие."}]}]}], "is_full_document": false, "schema": "docvortex.middle", "schema_version": "2.0"}