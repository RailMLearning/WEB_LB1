{"metadata": {"file_suffix": "pdf", "producer": {"name": "mineru", "version": "4.0.10"}, "document": {"title": "Как бэкенд обслуживает запросы - Request lifecycle, воркеры, потоки, event loop и async I/O в Python", "created_at": "2026-09-29T10:26:10+03:00", "modified_at": "2026-09-29T10:26:10+03:00", "creator_application": "LaTeX with Beamer class", "producer_application": "MiKTeX pdfTeX-1.40.27", "page_count": 50, "page_count_kind": "physical"}}, "extensions": {"mineru": {"tier": "standard", "parse_mode": "txt"}, "docvortex_layout": {"version": 1, "pages": [{"page_idx": 30, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 31, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 32, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 33, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 34, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 35, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 36, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 37, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 38, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}, {"page_idx": 39, "width_pt": 453.5429992675781, "height_pt": 255.1179962158203}]}}, "pages": [{"page_idx": 30, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.054], "content": [{"type": "text", "content": "страница 31/50"}]}, {"type": "header", "index": 1, "bbox": [0.03, 0.078, 0.325, 0.147], "content": [{"type": "text", "content": "GIL и CPU-задача"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.051, 0.977, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "text", "index": 3, "bbox": [0.184, 0.346, 0.816, 0.394], "content": [{"type": "text", "content": "Одна и та же вычислительная задача, пример замера на 4 ядрах"}]}, {"type": "chart", "index": 4, "bbox": [0.108, 0.402, 0.893, 0.684], "content": [{"type": "chart_body", "index": 4, "bbox": [0.108, 0.402, 0.893, 0.684], "content": ""}, {"type": "chart_footnote", "index": 5, "bbox": [0.064, 0.756, 0.391, 0.855], "content": [{"type": "text", "content": "Четыре потока не дали никакого ускорения: GIL."}]}, {"type": "chart_footnote", "index": 6, "bbox": [0.529, 0.756, 0.886, 0.853], "content": [{"type": "text", "content": "Процессы ускоряют: у каждого свой интерпретатор и свой GIL."}]}]}]}, {"page_idx": 31, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.055], "content": [{"type": "text", "content": "страница 32/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.076, 0.282, 0.151], "content": [{"type": "text", "content": "Python без GIL"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.795, 0.051, 0.977, 0.15], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.075, 0.351, 0.263, 0.406], "content": [{"type": "text", "content": "Что есть сейчас"}], "level": 2}, {"type": "image", "index": 4, "bbox": [0.399, 0.35, 0.452, 0.399], "content": [{"type": "image_body", "index": 4, "bbox": [0.399, 0.35, 0.452, 0.399], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.074, 0.415, 0.444, 0.506], "content": [{"type": "text", "content": "3.13", "styles": ["bold"]}, {"type": "text", "content": " (2024) — экспериментальная сборка без GIL (PEP 703)"}]}, {"type": "text", "index": 6, "bbox": [0.072, 0.512, 0.431, 0.69], "content": [{"type": "text", "content": "3.14", "styles": ["bold"]}, {"type": "text", "content": " (2025) — официально поддерживается (PEP 779), но "}, {"type": "text", "content": "не по умолчанию", "styles": ["bold"]}, {"type": "text", "content": ": отдельная сборка, ставится галочкой в установщике"}]}, {"type": "text", "index": 7, "bbox": [0.074, 0.695, 0.384, 0.787], "content": [{"type": "text", "content": "Проверить: python -VV покажет «free-threading build»"}]}, {"type": "paragraph_title", "index": 8, "bbox": [0.549, 0.354, 0.71, 0.406], "content": [{"type": "text", "content": "Что меняется"}], "level": 2}, {"type": "image", "index": 9, "bbox": [0.872, 0.35, 0.926, 0.401], "content": [{"type": "image_body", "index": 9, "bbox": [0.872, 0.35, 0.926, 0.401], "content": ""}]}, {"type": "text", "index": 10, "bbox": [0.547, 0.416, 0.907, 0.549], "content": [{"type": "text", "content": "+ потоки выполняют Python-код на всех ядрах — CPU-задача в 4 потоках ускоряется"}]}, {"type": "text", "index": 11, "bbox": [0.547, 0.556, 0.869, 0.643], "content": [{"type": "text", "content": "− однопоточный код медленнее на 5–10 %"}]}, {"type": "text", "index": 12, "bbox": [0.547, 0.643, 0.879, 0.735], "content": [{"type": "text", "content": "− C-расширение без поддержки при импорте включает GIL обратно"}]}, {"type": "text", "index": 13, "bbox": [0.263, 0.876, 0.736, 0.979], "content": [{"type": "text", "content": "Гонки никуда не деваются: Lock нужен так же. Веб-серверы пока масштабируются процессами"}]}]}, {"page_idx": 32, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.031, 0.078, 0.544, 0.151], "content": [{"type": "text", "content": "Гонка при записи в JSON-файл"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 33/50 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.073, 0.413, 0.356, 0.573], "content": [{"type": "code_body", "index": 2, "bbox": [0.073, 0.413, 0.356, 0.573], "content": "A: read count = 5\nB: read count = 5\nA: write count = 6\nB: write count = 6 # lost"}], "sub_type": "code", "guess_lang": "txt"}, {"type": "code", "index": 3, "bbox": [0.074, 0.714, 0.471, 0.872], "content": [{"type": "code_body", "index": 3, "bbox": [0.074, 0.714, 0.471, 0.872], "content": "with lock:  # one per repository\n    data = json.loads(DB.read_text())\n    data[\"count\"] += 1\n    DB.write_text(json.dumps(data))"}], "sub_type": "code", "guess_lang": "python"}, {"type": "text", "index": 4, "bbox": [0.654, 0.317, 0.942, 0.449], "content": [{"type": "text", "content": "∙ Два потока прочитали одно значение — одно обновление потеряно"}]}, {"type": "text", "index": 5, "bbox": [0.653, 0.461, 0.939, 0.591], "content": [{"type": "text", "content": "∙ Поток может прочитать файл, записанный наполовину — JSONDecodeError, 500"}]}, {"type": "text", "index": 6, "bbox": [0.653, 0.608, 0.937, 0.733], "content": [{"type": "text", "content": "∙ Lock делает «прочитать — изменить — записать» одним шагом"}]}]}, {"page_idx": 33, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.979, 0.054], "content": [{"type": "text", "content": "страница 34/50"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.08, 0.498, 0.152], "content": [{"type": "text", "content": "Примитивы синхронизации"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "table", "index": 3, "bbox": [0.067, 0.24, 0.937, 0.779], "content": [{"type": "table_body", "index": 3, "bbox": [0.067, 0.24, 0.937, 0.779], "content": "<table><tr><td>Примитив</td><td>Что делает</td><td>Пример в вебе</td></tr><tr><td>Lock</td><td>в секции только один поток</td><td>запись в JSON-файл</td></tr><tr><td>RLock</td><td>тот же поток может взять его повторно</td><td>вложенные вызовы с одним локом</td></tr><tr><td>Semaphore(n)</td><td>в секции не больше n потоков</td><td>не больше 5 запросов к внешнему API</td></tr><tr><td>Event</td><td>«жди, пока не скажут»</td><td>ждать, пока загрузится конфиг</td></tr><tr><td>Queue</td><td>безопасная очередь между потоками</td><td>фоновый обработчик задач</td></tr></table>"}]}, {"type": "text", "index": 4, "bbox": [0.165, 0.869, 0.834, 0.996], "content": [{"type": "text", "content": "Lock — по сути Semaphore(1). Queue часто лучше ручных локов: потоки не делят данные, а передают их друг другу"}]}]}, {"page_idx": 34, "blocks": [{"type": "code", "index": 0, "bbox": [0.061, 0.437, 0.51, 0.74], "content": [{"type": "code_body", "index": 0, "bbox": [0.061, 0.437, 0.51, 0.74], "content": "api_limit = threading.Semaphore(5)\n\ndef call_api(url):\n    with api_limit:      # max 5 at once\n        return requests.get(url)"}], "sub_type": "code", "guess_lang": "python"}, {"type": "paragraph_title", "index": 1, "bbox": [0.03, 0.079, 0.738, 0.152], "content": [{"type": "text", "content": "Semaphore: ограничить одновременность"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.797, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 35/50 iiTMO"}]}, {"type": "text", "index": 3, "bbox": [0.591, 0.403, 0.933, 0.547], "content": [{"type": "text", "content": "∙ Пришло 100 запросов к нашему бэкенду — во внешний сервис одновременно уйдут только 5"}]}, {"type": "text", "index": 4, "bbox": [0.591, 0.568, 0.921, 0.661], "content": [{"type": "text", "content": "∙ Остальные ждут на with, пока кто-то не выйдет из секции"}]}, {"type": "text", "index": 5, "bbox": [0.591, 0.684, 0.934, 0.824], "content": [{"type": "text", "content": "Внешний сервис не упадёт и не заблокирует нас за превышение лимита"}]}]}, {"page_idx": 35, "blocks": [{"type": "header", "index": 0, "bbox": [0.797, 0.052, 0.975, 0.15], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "header", "index": 1, "bbox": [0.852, 0.017, 0.979, 0.054], "content": [{"type": "text", "content": "страница 36/50"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.031, 0.078, 0.761, 0.151], "content": [{"type": "text", "content": "RLock: лок, который можно взять повторно"}], "level": 2}, {"type": "code", "index": 3, "bbox": [0.06, 0.367, 0.54, 0.849], "content": [{"type": "code_body", "index": 3, "bbox": [0.06, 0.367, 0.54, 0.849], "content": "lock = threading.RLock()\n\ndef add_student(s):\n    with lock:\n        storage[s.isu] = s\n        save_all()  # same lock again\n\ndef save_all():\n    with lock:\n        DB.write_text(json.dumps(storage))"}], "sub_type": "code", "guess_lang": "python"}, {"type": "text", "index": 4, "bbox": [0.627, 0.323, 0.943, 0.454], "content": [{"type": "text", "content": "∙ С обычным Lock поток зависнет навсегда: save_all ждёт лок, который держит он сам"}]}, {"type": "text", "index": 5, "bbox": [0.627, 0.467, 0.93, 0.642], "content": [{"type": "text", "content": "∙ RLock помнит, какой поток его держит, и считает захваты. Отпускается, когда счётчик дошёл до нуля"}]}, {"type": "text", "index": 6, "bbox": [0.628, 0.656, 0.881, 0.74], "content": [{"type": "text", "content": "∙ Другие потоки ждут, как с обычным Lock"}]}, {"type": "text", "index": 7, "bbox": [0.627, 0.756, 0.943, 0.929], "content": [{"type": "text", "content": "∙ Часто лучше без RLock: вынести запись в функцию, которая лок не берёт и вызывается только под ним"}]}]}, {"page_idx": 36, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.032, 0.082, 0.525, 0.151], "content": [{"type": "text", "content": "Event: «жди, пока не скажут»"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 37/50 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.062, 0.362, 0.549, 0.92], "content": [{"type": "code_body", "index": 2, "bbox": [0.062, 0.362, 0.549, 0.92], "content": "config_ready = threading.Event()\n\ndef load_config():    # in a thread\n    global config\n    config = fetch_config()\n    config_ready.set()\n\n@app.get(\"/students\")\ndef students():\n    if not config_ready.wait(timeout=5):\n        return {\"error\": \"not ready\"}, 503\n    ..."}], "sub_type": "code", "guess_lang": "python"}, {"type": "text", "index": 3, "bbox": [0.628, 0.317, 0.909, 0.406], "content": [{"type": "text", "content": "∙ wait() ждёт, пока кто-то не вызовет set()"}]}, {"type": "text", "index": 4, "bbox": [0.628, 0.419, 0.943, 0.508], "content": [{"type": "text", "content": "∙ Один set() будит "}, {"type": "text", "content": "всех", "styles": ["bold"]}, {"type": "text", "content": " ждущих, флаг остаётся поднятым"}]}, {"type": "text", "index": 5, "bbox": [0.628, 0.52, 0.9, 0.609], "content": [{"type": "text", "content": "∙ wait(timeout=5) вернёт False, если не дождался"}]}, {"type": "text", "index": 6, "bbox": [0.628, 0.622, 0.945, 0.753], "content": [{"type": "text", "content": "∙ Ещё применение — остановка: фоновый поток крутится, пока не поднят stop_event"}]}]}, {"page_idx": 37, "blocks": [{"type": "header", "index": 0, "bbox": [0.797, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 38/50 iiTMO"}]}, {"type": "paragraph_title", "index": 1, "bbox": [0.032, 0.08, 0.566, 0.154], "content": [{"type": "text", "content": "Queue: передавать, а не делить"}], "level": 2}, {"type": "code", "index": 2, "bbox": [0.072, 0.396, 0.528, 0.9], "content": [{"type": "code_body", "index": 2, "bbox": [0.072, 0.396, 0.528, 0.9], "content": "tasks = queue.Queue()\ndef worker():\n    while True:\n        email = tasks.get()  # waits\n        send_email(email)\n        tasks.task_done()\nThread(target=worker, daemon=True).start()\n\n@app.post(\"/register\")\ndef register(user: UserIn):\n    save(user)\n    tasks.put(user.email)   # no wait\n    return {\"ok\": True}"}], "sub_type": "code", "guess_lang": "python"}, {"type": "text", "index": 3, "bbox": [0.628, 0.305, 0.936, 0.433], "content": [{"type": "text", "content": "∙ Обработчик кладёт задачу и "}, {"type": "text", "content": "сразу", "styles": ["bold"]}, {"type": "text", "content": " отвечает, письмо уходит в фоне"}]}, {"type": "text", "index": 4, "bbox": [0.628, 0.45, 0.914, 0.58], "content": [{"type": "text", "content": "∙ Данные не общие, а передаются — локи писать не нужно, они внутри Queue"}]}, {"type": "text", "index": 5, "bbox": [0.627, 0.592, 0.912, 0.724], "content": [{"type": "text", "content": "∙ Queue(maxsize=100): при переполнении put ждёт — защита от перегрузки"}]}, {"type": "text", "index": 6, "bbox": [0.628, 0.739, 0.899, 0.911], "content": [{"type": "text", "content": "∙ Очередь живёт в памяти процесса: при перезапуске задачи пропадут. В проде — Celery или RQ"}]}]}, {"page_idx": 38, "blocks": [{"type": "code", "index": 0, "bbox": [0.068, 0.36, 0.467, 0.591], "content": [{"type": "code_body", "index": 0, "bbox": [0.068, 0.36, 0.467, 0.591], "content": "with accounts_lock:\n    with logs_lock:\n        ..."}], "sub_type": "code", "guess_lang": "txt"}, {"type": "header", "index": 1, "bbox": [0.032, 0.079, 0.188, 0.142], "content": [{"type": "text", "content": "Deadlock"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.017, 0.979, 0.148], "content": [{"type": "text", "content": "страница 39/50 viTMO"}]}, {"type": "paragraph_title", "index": 3, "bbox": [0.224, 0.285, 0.307, 0.336], "content": [{"type": "text", "content": "Поток 1"}], "level": 2}, {"type": "paragraph_title", "index": 4, "bbox": [0.69, 0.283, 0.775, 0.336], "content": [{"type": "text", "content": "Поток 2"}], "level": 2}, {"type": "code", "index": 5, "bbox": [0.55, 0.412, 0.804, 0.584], "content": [{"type": "code_body", "index": 5, "bbox": [0.55, 0.412, 0.804, 0.584], "content": "with logs_lock:\n    with accounts_lock:\n        ..."}], "sub_type": "code", "guess_lang": "txt"}, {"type": "text", "index": 6, "bbox": [0.083, 0.65, 0.813, 0.7], "content": [{"type": "text", "content": "∙ Каждый поток держит один лок и ждёт второй — ждать они будут "}, {"type": "text", "content": "вечно", "styles": ["bold"]}]}, {"type": "text", "index": 7, "bbox": [0.083, 0.721, 0.919, 0.815], "content": [{"type": "text", "content": "∙ Сервер не падает, а просто перестаёт отвечать, и в логах ничего нет. Поэтому такие ошибки трудно искать"}]}, {"type": "text", "index": 8, "bbox": [0.083, 0.838, 0.902, 0.934], "content": [{"type": "text", "content": "∙ "}, {"type": "text", "content": "Самоблокировка:", "styles": ["bold"]}, {"type": "text", "content": " поток повторно берёт обычный Lock, который уже держит сам (для этого и есть RLock)"}]}]}, {"page_idx": 39, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.98, 0.054], "content": [{"type": "text", "content": "страница 40/50"}]}, {"type": "header", "index": 1, "bbox": [0.03, 0.078, 0.473, 0.145], "content": [{"type": "text", "content": "Как не попасть в deadlock"}]}, {"type": "header", "index": 2, "bbox": [0.796, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "text", "index": 3, "bbox": [0.167, 0.44, 0.683, 0.492], "content": [{"type": "text", "content": "1. Брать локи всегда "}, {"type": "text", "content": "в одном и том же порядке", "styles": ["bold"]}]}, {"type": "image", "index": 4, "bbox": [0.798, 0.402, 0.851, 0.45], "content": [{"type": "image_body", "index": 4, "bbox": [0.798, 0.402, 0.851, 0.45], "content": ""}]}, {"type": "text", "index": 5, "bbox": [0.167, 0.505, 0.841, 0.608], "content": [{"type": "text", "content": "2. Держать лок как можно меньше: не делать под ним I/O и не вызывать чужой код"}]}, {"type": "text", "index": 6, "bbox": [0.167, 0.621, 0.653, 0.673], "content": [{"type": "text", "content": "3. По возможности обходиться "}, {"type": "text", "content": "одним", "styles": ["bold"]}, {"type": "text", "content": " локом"}]}, {"type": "text", "index": 7, "bbox": [0.167, 0.685, 0.799, 0.791], "content": [{"type": "text", "content": "4. Ставить таймаут: lock.acquire(timeout=1) вернёт False вместо вечного ожидания"}]}]}], "is_full_document": false, "schema": "docvortex.middle", "schema_version": "2.0"}