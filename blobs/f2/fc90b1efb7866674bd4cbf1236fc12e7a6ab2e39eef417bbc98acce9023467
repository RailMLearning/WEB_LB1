n    void sayQuote();\n}\n\npublic class TerminatorQuoter\n    implements Quoter {\n    private int repeat;\n    private String message = \"I'll be back\";\n\n    public void sayQuote() {\n        for (int i = 0; i < repeat; i++)\n            System.out.println(message);\n    }\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "paragraph_title", "index": 1, "bbox": [0.032, 0.079, 0.33, 0.151], "content": [{"type": "text", "content": "Сквозной пример"}], "level": 2}, {"type": "header", "index": 2, "bbox": [0.796, 0.018, 0.979, 0.147], "content": [{"type": "text", "content": "страница 17/55 viTMO"}]}]}, {"page_idx": 17, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.03, 0.076, 0.538, 0.151], "content": [{"type": "text", "content": "Задача: @InjectRandomInt"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.98, 0.148], "content": [{"type": "text", "content": "страница 18/55 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.069, 0.454, 0.522, 0.81], "content": [{"type": "code_body", "index": 2, "bbox": [0.069, 0.454, 0.522, 0.81], "content": "public class TerminatorQuoter\n    implements Quoter {\n\n    @InjectRandomInt(min = 2, max = 7)\n    private int repeat;\n\n    private String message = \"I'll be back\";\n    ...\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "code", "index": 3, "bbox": [0.637, 0.43, 0.928, 0.808], "content": [{"type": "code_body", "index": 3, "bbox": [0.637, 0.43, 0.928, 0.808], "content": "Вопрос\nТребуется: фраза повторяется случайное число раз, от 2 до 7.\nАннотация — просто метка.\nКто положит значение в поле?"}], "sub_type": "code", "guess_lang": "txt"}]}, {"page_idx": 18, "blocks": [{"type": "paragraph_title", "index": 0, "bbox": [0.031, 0.078, 0.484, 0.15], "content": [{"type": "text", "content": "Первый BeanPostProcessor"}], "level": 2}, {"type": "header", "index": 1, "bbox": [0.796, 0.017, 0.979, 0.147], "content": [{"type": "text", "content": "страница 19/55 viTMO"}]}, {"type": "code", "index": 2, "bbox": [0.08, 0.331, 0.679, 0.821], "content": [{"type": "code_body", "index": 2, "bbox": [0.08, 0.331, 0.679, 0.821], "content": "public class InjectRandomIntAnnotationBeanPostProcessor\n    implements BeanPostProcessor {\n\n    @Override\n    public Object postProcessBeforeInitialization(Object bean, String name) {\n        for (Field f : bean.getClass().getDeclaredFields()) {\n            InjectRandomInt a = f.getAnnotation(InjectRandomInt.class);\n            if (a != null) {\n                int v = ThreadLocalRandom.current().nextInt(a.min(), a.max() + 1);\n                f.setAccessible(true);\n                ReflectionUtils.setField(f, bean, v);\n            }\n        }\n        return bean;\n    }\n}"}], "sub_type": "code", "guess_lang": "java"}, {"type": "code", "index": 3, "bbox": [0.077, 0.89, 0.771, 0.997], "content": [{"type": "code_body", "index": 3, "bbox": [0.077, 0.89, 0.771, 0.997], "content": "Это та же рефлексия, только её запускает контейнер для каждого бина"}], "sub_type": "code", "guess_lang": "txt"}]}, {"page_idx": 19, "blocks": [{"type": "header", "index": 0, "bbox": [0.852, 0.017, 0.979, 0.054], "content": [{"type": "text", "content": "страница 20/55"}]}, {"type": "header", "index": 1, "bbox": [0.795, 0.052, 0.976, 0.148], "content": [{"type": "text", "content": "viTMO"}]}, {"type": "paragraph_title", "index": 2, "bbox": [0.088, 0.283, 0.256, 0.324], "content": [{"type": "text", "content": "BeanPostProcessor"}], "level": 2}, {"type": "text", "index": 3, "bbox": [0.087, 0.344, 0.525, 0.389], "content": [{"type": "text", "content": "AutowiredAnnotationBeanPostProcessor"}]}, {"type": "text", "index": 4, "bbox": [0.088, 0.405, 0.49, 0.451], "content": [{"type": "text", "content": "CommonAnnotationBeanPostProcessor"}]}, {"type": "text", "index": 5, "bbox": [0.087, 0.463, 0.548, 0.512], "content": [{"type": "text", "content": "AnnotationAwareAspectJAutoProxyCreator"}]}, {"type": "paragraph_title", "index": 6, "bbox": [0.