  "item": [
    {
      "name": "01 Регистрация USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"email\": \"{{email}}\", \"password\": \"{{userPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "const suffix = String(Date.now());",
              "pm.collectionVariables.set(\"username\", \"lab\" + suffix);",
              "pm.collectionVariables.set(\"email\", \"lab\" + suffix + \"@example.com\");",
              "pm.collectionVariables.set(\"isu\", \"0\" + suffix.slice(-5));",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Вход USER",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"{{username}}\", \"password\": \"{{userPassword}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const tokenData = pm.response.json();",
              "pm.collectionVariables.set(\"userAccess\", tokenData.accessToken);",
              "pm.collectionVariables.set(\"userRefresh\", tokenData.refreshToken);",
              "pm.test(\"USER role\", () => pm.expect(tokenData.user.role).to.eql(\"USER\"));",
              "}"
            ]
          }
        }
      ]
    },
