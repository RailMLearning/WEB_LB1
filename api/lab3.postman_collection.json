          }
        ],
        "url": "{{baseUrl}}/api/auth/refresh",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{userRefresh}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "{",
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
              "}"
            ]
          }
        }
      ]
    }
  ]
}
